{
  "name": "@mostajs/multitenancy",
  "version": "0.2.0",
  "description": "Tenant context + AsyncLocalStorage scoping for multi-tenant @mostajs/* apps. Express/Next/Fastify middleware pour extraire le tenantId par requête. Composable avec @mostajs/repository (withTenantScope).",
  "author": "Dr Hamid MADANI <drmdh@msn.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node node_modules/@mostajs/mjs-unit/bin/cli.mjs test-scripts/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@mostajs/mjs-unit": "^0.7.0",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "mostajs": {
    "niveau": "N0",
    "nature": "primitif",
    "reutilisabilite": "universelle",
    "depend_de": []
  }
}
